# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_finance?schema=public

# JWT Security Secrets
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_32chars
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
